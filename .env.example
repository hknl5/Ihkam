# Copy to .env and fill in. .env is never committed.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Riyadh
# Where uploaded course material is stored (relative to the repo root).
DJANGO_MEDIA_ROOT=media

# --- PostgreSQL (pgvector extension required) ---
POSTGRES_DB=ihkam
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- LLM provider (§3) ---
# openai | gemini | airllm (airllm is a phase-2 stub, not implemented yet)
LLM_PROVIDER=openai

# Width of every embedding the app stores. Both API providers are asked to
# emit this size, so switching providers does not invalidate stored vectors.
# Changing it after the first migration needs a migration and a re-embed —
# the chunks table stores a fixed-width column.
EMBEDDING_DIM=1536

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- OCR provider (agents/ocr.py) ---
# Pages extraction could not read in full are transcribed by a vision-language
# model — no text layer, a text layer covering only the title, or one whose
# embedded fonts map letters to junk.
# gemini | paddlevl (paddlevl is a phase-2 local stub, not implemented yet)
OCR_PROVIDER=gemini
# Defaults to GEMINI_MODEL when unset.
GEMINI_OCR_MODEL=
OCR_RENDER_WIDTH=1600
# OCR runs synchronously during upload. Set false to skip it entirely.
OCR_ENABLED=true
# Pages are sent one image per call; these only shorten the total wait.
OCR_CONCURRENCY=5
OCR_MAX_PAGES_PER_FILE=60
# Retries per page when the provider rate-limits. Free Gemini keys are capped
# at a few requests per minute, which makes a large deck much slower.
OCR_MAX_ATTEMPTS=5

# --- When a page counts as "not read in full" ---
# Measured on the real lecture files; see config/settings.py for the evidence
# behind each number before changing one.
# A page whose body is an image: few letters, much of the page covered by one.
OCR_MIXED_MAX_LETTERS=80
OCR_MIXED_MIN_IMAGE_COVERAGE=0.20
# A page whose embedded fonts map letters to junk.
OCR_DEFECTIVE_MIN_CHARS=8
OCR_DEFECTIVE_MIN_RATIO=0.005
# Keep the text layer when a transcription comes back this much shorter.
OCR_MIN_KEEP_RATIO=0.6

# --- Chunking + embeddings (M2, courses/services/chunking.py) ---
# Passages are embedded at the end of upload. Set false to upload without
# spending embedding calls; `manage.py build_chunks` fills them in later.
EMBEDDINGS_ENABLED=true
# A passage never crosses a page boundary — a citation is only as good as the
# page number on the passage it quotes. Within a page, paragraphs are packed up
# to the maximum; a fragment under the minimum is joined to the next.
CHUNK_MAX_CHARS=1200
CHUNK_MIN_CHARS=200
# Passages per embedding request. Round trips only, never what is stored.
EMBED_BATCH_SIZE=64

# --- Topic extraction (M2, courses/services/topics.py) ---
# Ceiling on the course text sent in one extraction call. Pages that do not fit
# are named in the result rather than silently dropped.
TOPIC_EXTRACTION_MAX_CHARS=150000
